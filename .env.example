# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Browser-exposed (VITE_ vars are bundled into the public JS). Anon/publishable keys ONLY.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Server-side only. NEVER prefix these with VITE_.
# Used by seed.js / fix_assistant.js. Keep in .env.local, never in Vercel client env.
SUPABASE_SERVICE_ROLE_KEY=""
# Set as Supabase edge function secrets (supabase secrets set ...), not in the client:
#   STRIPE_SECRET_KEY, ALLOWED_ORIGIN (e.g. https://your-app.vercel.app)

# Dev only: merge demo patients/visits (src/mocks) into query results. Leave unset in production.
VITE_USE_MOCK_DATA=""
